{
  "name": "codefox",
  "displayName": "CodeFox",
  "description": "A tiny pixel fox that roams your Explorer sidebar. Click to jump, hold to crouch, double-click to sprint.",
  "version": "0.0.3",
  "publisher": "KrushnaKoshatwar",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "CodeFox contributors",
  "homepage": "https://github.com/Oaklaan/CodeFox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oaklaan/CodeFox.git"
  },
  "bugs": {
    "url": "https://github.com/Oaklaan/CodeFox/issues"
  },
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": ["onStartupFinished"],
  "categories": ["Other"],
  "keywords": ["fox", "pet", "game", "fun"],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "views": {
      "explorer": [
        { "type": "webview", "id": "codefox.view", "name": "Fox" }
      ]
    },
    "commands": [
      { "command": "codefox.show", "title": "Fox: Show" }
    ],
    "configuration": {
      "title": "CodeFox",
      "properties": {
        "codefox.showOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the Fox view when VS Code starts."
        },
        "codefox.scale": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "maximum": 8,
          "description": "Pixel size of the fox sprite."
        },
        "codefox.wander": {
          "type": "boolean",
          "default": true,
          "description": "Let the fox walk around and fall asleep on his own."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:wasm": "wasm-pack build core --target web --out-dir ../webview/pkg --out-name fox_core --release && node -e \"require('fs').rmSync('webview/pkg/.gitignore',{force:true})\"",
    "build": "npm run build:wasm && npm run compile",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
